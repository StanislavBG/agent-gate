{
  "name": "@bilkobibitkov/agent-gate",
  "version": "0.2.3",
  "description": "Pre-deploy CI gate for AI agents: regression tests, compliance scan, cost check — unified pass/fail verdict",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "agent-gate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "ci",
    "compliance",
    "eu-ai-act",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanislavBG/agent-gate.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bilkobibitkov/preflight-license": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
